const express = require('express');
const cors = require('cors');
const app = express();

// 1. 配置中间件
app.use(cors()); // 允许跨域访问
app.use(express.json()); // 解析前端发送的 JSON 数据

// 2. 定义登录接口
app.post('/api/login', (req, res) => {
    // 获取前端传来的用户名和密码
    const { username, password } = req.body;

    console.log(`收到登录请求: 用户名=${username}, 密码=${password}`);

    // 3. 校验逻辑 (按照任务书要求硬编码)
    if (username === 'admin' && password === '123456') {
        // 登录成功
        res.status(200).json({
            code: 0,
            message: "Login successful",
            data: {
                // 生成一个简单的模拟 Token
                token: "abcdef" + Math.random().toString(16).slice(2)
            }
        });
    } else {
        // 登录失败
        res.status(200).json({
            code: 1,
            message: "Invalid username or password",
            data: null
        });
    }
});

// 4. 启动服务器
const PORT = 3000;
app.listen(PORT, () => {
    console.log(`后端服务已启动：http://localhost:${PORT}`);
    console.log(`登录接口地址：http://localhost:${PORT}/api/login`);
});
